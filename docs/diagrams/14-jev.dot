digraph jev {
 graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.55",fontname="Arial",label="Jev selection, state ownership and delivery commit",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#edf4ff",color="#45618a",fontname="Arial",fontsize=12,margin="0.5,0.18"];
 edge [fontname="Arial",fontsize=10,color="#526276"];
 enable [label="Explicit enable: validated owner-only key + config\nClaude/Codex adapters suppress legacy retrieval"];
 context [label="runJevStruggle validates session + transcript payload\nThroughline public context: exactly 3 completed turns\n1.5s command guard; read session lastTurn before judging"];
 silent [fillcolor="#fff0d7",label="Return null without new observation\ndisabled / unavailable / incomplete / projection_pending\nor same lastTurn already saved"];
 score [label="Jev jev-1.13.0: repeated problem AND clearly stuck >= .8\nAPI receives completed conversation text; 1.5s request guard\nchoose at most 3 terms above none probability"];
 below [label="Below struggle threshold\nwrite observation delivery=none -> save session lastTurn -> null"];
 fts [label="Nonempty query: local AND FTS, at most 20 candidates\nfinally close search DB BEFORE relevance API call\nJev receives conversation + candidate excerpts; match >= .8"];
 matched [label="Matched reference: source/id\nsuppress if session deliveredIds OR hook-delivery contains ID"];
 generic [label="Generic reminder: selectedRef=null\nno_terms / no_candidates / below_match_threshold\nsuppress if notifiedTerms contains query or '_none'"];
 dedupe [shape=diamond,label="Already delivered\nby the applicable ID / term check?"];
 suppressed [label="write observation delivery=suppressed, noticeText=null\nthen save session lastTurn -> return null; no output"];
 pending [label="write decision + observation delivery=pending\nreturn proposed notice + delivered callback\nsession cursor / delivery ID or term not yet saved"];
 output [label="Host delivery (see 05): prepare deduped texts\nnonempty texts require successful stdout callback\nprepared.delivered -> notice.delivered only if text included\nthen pending ack; host use is not proven"];
 commit [label="Jev delivered callback: reload session, prepare lastTurn\nmatched adds ID; generic adds term\nwrite observation delivered -> save session\nselected only: separate DB markHit, finally close"];
 session [shape=cylinder,fillcolor="#fff0d7",label="jevStruggle owns jev-sessions\nlastTurn / deliveredIds / notifiedTerms"];
 observation [shape=cylinder,fillcolor="#fff0d7",label="jevObservations owns jev-observations\ndecision / delivery / turn references / human review\nCaveat does not persist raw conversation text"];
 ledger [shape=cylinder,fillcolor="#fff0d7",label="hookDelivery owns hook-delivery (05)\nshared session delivered IDs / signals\nprepared.delivered writes; wasHitDelivered reads"];
 review [label="CLI cases/review + Web Jev view\nread observations; show evaluated denominators and reasons"];
 error [fillcolor="#ffe3e3",label="Any invalid payload/context, key/API/DB or persistence failure\nthrow to host stderr catch; no fabricated failure observation\noutput/commit errors reach delivery stderr catch\nseparate writes may partially persist; no rollback claim"];
 enable -> context -> score;
 enable -> silent [label="disabled"];
 context -> silent [label="unavailable / same turn"];
 context -> error [label="invalid / command failure"];
 score -> below [label="not struggling"];
 score -> fts [label="struggling + terms"];
 score -> generic [label="struggling, no_terms"];
 score -> error [label="key / API failure"];
 fts -> matched [label="selected"];
 fts -> generic [label="no selected candidate"];
 fts -> error [label="search / ranking failure"];
 matched -> dedupe; generic -> dedupe;
 dedupe -> suppressed [label="yes"];
 dedupe -> pending [label="no"];
 pending -> output -> commit;
 {below suppressed commit} -> session [style=dashed];
 {below suppressed pending commit} -> observation [style=dashed];
 session -> context [style=dashed,label="cursor / dedupe read",constraint=false];
 ledger -> matched [style=dashed,constraint=false];
 observation -> review;
 commit -> error [style=dashed,label="output / persistence exception",constraint=false];
}
