digraph runtime {
 graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.5", fontname="Arial", label="Runtime collection and signed report acknowledgement | refactor candidate", labelloc=t];
 node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#45618a", fontname="Arial", fontsize=12, margin="0.8,0.18"];
 edge [fontname="Arial", fontsize=10, color="#526276"];
 producer [label="Operation producer\nfixed code + observed impact\nexpected refusals handled separately"];
 local [label="runtimeErrors owns opt-in local store\nowner-only file + SQLite mutation lock\nvalidate -> update fingerprint/sequence/severity\natomic file replace"];
 inspect [label="snapshot / diagnostics / resolve / reopen\ncompact only old resolved + acknowledged rows"];
 due [label="hook error or Stop\nruntimeErrorReportDue: cheap pending/backoff check\nspawn detached report worker; not send completion"];
 claim [label="sendRuntimeErrorReport\ncollection AND credential-path opt-in\nclaim pending rows + in-flight state under lock"];
 credentials [label="Validate owner-only credential file\nread exact file identity\nconfigured URL / key id / signing secret"];
 post [label="Signed POST of exact JSON bytes\nno redirects; bounded request timeout"];
 verify [shape=diamond, label="HTTP 200 + accepted\nsame report id\nvalid signed receipt?"];
 ack [label="acknowledge claimed cursor\nsave accepted + retry time\nreturn sent"];
 retry [fillcolor="#fff0d7", label="Keep runtime rows pending\nsave fixed failure outcome + retry time\nnever register send failure as another runtime error"];
 producer -> local;
 local -> inspect;
 local -> due -> claim -> credentials -> post -> verify;
 verify -> ack [label="yes"];
 verify -> retry [label="no / timeout / unreachable"];
 credentials -> retry [label="unsafe / missing / invalid"];
 retry -> due [style=dashed, label="later opportunity"];
}
