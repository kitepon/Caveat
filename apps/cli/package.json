{
  "name": "caveat-cli",
  "version": "0.19.1",
  "description": "Long-term memory CLI for Claude Code, Codex, and Cursor (markdown + SQLite FTS5 + MCP + hooks)",
  "keywords": [
    "caveat",
    "knowledge-base",
    "gotcha",
    "claude-code",
    "codex",
    "cursor",
    "coding-agents",
    "openai",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "Quo / クオ at kitepon.dev",
    "url": "https://kitepon.dev/"
  },
  "homepage": "https://github.com/kitepon/Caveat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitepon/Caveat.git"
  },
  "bugs": {
    "url": "https://github.com/kitepon/Caveat/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "caveat": "dist/caveat.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "node ../../scripts/verify-release-commit.mjs"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "smol-toml": "1.7.0"
  },
  "devDependencies": {
    "@caveat/core": "workspace:*",
    "@caveat/mcp": "workspace:*",
    "@caveat/web": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
