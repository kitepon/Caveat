{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caveat:factory-private-evidence-capability:v1",
  "title": "Draft: Caveat official private evidence capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "package_version",
    "public_diagnostic_schema",
    "private_protocol",
    "transports",
    "max_channel_bytes",
    "operation_receipt"
  ],
  "properties": {
    "schema": {
      "const": "caveat.factory_private_evidence_capability.v1"
    },
    "product": {
      "const": "caveat"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 128
    },
    "public_diagnostic_schema": {
      "const": "caveat.native_factory_diagnostics.v1"
    },
    "private_protocol": {
      "const": "caveat.factory_private_evidence.v1"
    },
    "transports": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "platforms",
              "launch_paths"
            ],
            "properties": {
              "id": {
                "const": "posix-fd-v1"
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "linux",
                    "darwin"
                  ]
                }
              },
              "launch_paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "direct_node_entry"
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "platforms",
              "launch_paths"
            ],
            "properties": {
              "id": {
                "const": "windows-named-pipe-v1"
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "win32"
                  ]
                }
              },
              "launch_paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "native_exe",
                    "powershell_standard_shim"
                  ]
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "posix-fd-v1"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "windows-named-pipe-v1"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "max_channel_bytes": {
      "const": 16384
    },
    "operation_receipt": {
      "const": "not_supported"
    }
  }
}
